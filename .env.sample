# ==============================================================================
# DNS Resolver Configuration
# ==============================================================================
# Copy this file to .env and customize as needed

# ------------------------------------------------------------------------------
# DNS Servers for Queries
# ------------------------------------------------------------------------------
# List of DNS server IPs to query (one per line or comma-separated).
# Leave empty to use system resolver (from /etc/resolv.conf)
DNS_SERVERS="
8.8.8.8
1.1.1.1
9.9.9.9
"

# ------------------------------------------------------------------------------
# Default DNS Servers (Dropdown Selection)
# ------------------------------------------------------------------------------
# Servers shown in the dropdown menu for users to select.
# Format: Name:IP pairs, one per line (or semicolon-separated)
DEFAULT_DNS_SERVERS="
Google Primary:8.8.8.8
Google Secondary:8.8.4.4
Cloudflare Primary:1.1.1.1
Cloudflare Secondary:1.0.0.1
Quad9 Primary:9.9.9.9
Quad9 Secondary:149.112.112.112
OpenDNS Primary:208.67.222.222
OpenDNS Secondary:208.67.220.220
"

# ------------------------------------------------------------------------------
# Global DNS Servers (Propagation Checking)
# ------------------------------------------------------------------------------
# Servers used for DNS propagation checks across different regions.
# Format: Name:IP pairs, one per line (or semicolon-separated)
GLOBAL_DNS_SERVERS="
Google (US):8.8.8.8
Cloudflare (US):1.1.1.1
Quad9 (US):9.9.9.9
OpenDNS (US):208.67.222.222
Level3 (US):4.2.2.1
Comodo (US):8.26.56.26
CleanBrowsing (US):185.228.168.9
AdGuard (Cyprus):94.140.14.14
Yandex (Russia):77.88.8.8
DNS.Watch (Germany):84.200.69.80
Freenom (Netherlands):80.80.80.80
UncensoredDNS (Denmark):91.239.100.100
Hurricane Electric (US):74.82.42.42
puntCAT (Spain):109.69.8.51
Neustar (US):156.154.70.5
SafeDNS (US):195.46.39.39
"

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
# HTTP port for the web server
PORT=60200

# Flask environment (development or production)
FLASK_ENV=production

# ------------------------------------------------------------------------------
# Rate Limiting (Optional)
# ------------------------------------------------------------------------------
# Use an external storage backend for rate limiting.
# Required for multi-worker deployments to share rate limit state.
# Supports: redis://, memcached://, memory://
# Example: redis://redis:6379/0
LIMITER_STORAGE_URI=

# ------------------------------------------------------------------------------
# Logging (Optional)
# ------------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
